#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * KaririCode Dotenv CLI — standalone tooling for .env files.
 *
 * Usage:
 *   kariricode-dotenv <command> [arguments] [options]
 *
 * Every command exits 0 on success and 1 on any error.
 */

namespace KaririCode\Dotenv\Console;

(static function (): void {
    foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $file) {
        if (is_file($file)) {
            require $file;

            return;
        }
    }

    fwrite(STDERR, "Cannot find vendor/autoload.php. Run: composer install\n");
    exit(1);
})();

use KaririCode\Dotenv\Cache\PhpFileCache;
use KaririCode\Dotenv\Core\DotenvParser;
use KaririCode\Dotenv\Core\EnvFileScanner;
use KaririCode\Dotenv\Dotenv;
use KaririCode\Dotenv\Enum\LoadMode;
use KaririCode\Dotenv\Exception\ConfigurationException;
use KaririCode\Dotenv\Exception\DotenvException;
use KaririCode\Dotenv\Exception\FileNotFoundException;
use KaririCode\Dotenv\Exception\ValidationException;
use KaririCode\Dotenv\Security\Encryptor;
use KaririCode\Dotenv\Security\EnvFileCipher;
use KaririCode\Dotenv\Security\KeyPair;
use KaririCode\Dotenv\ValueObject\DotenvConfiguration;

// ── Entry Point ──────────────────────────────────────────────────────

/** @var list<string> $arguments */
$arguments = array_values(array_slice($argv, 1));
$command = $arguments[0] ?? 'help';
[$positional, $options] = parseArguments(array_slice($arguments, 1));

try {
    $exitCode = match ($command) {
        'debug' => commandDebug($options),
        'validate' => commandValidate($options),
        'encrypt' => commandEncrypt($positional, $options),
        'decrypt' => commandDecrypt($positional, $options),
        'cache:dump' => commandCacheDump($options),
        'cache:clear' => commandCacheClear($options),
        'diff' => commandDiff($positional),
        'example:generate' => commandExampleGenerate($positional, $options),
        'keygen' => commandKeygen(),
        'help', '--help', '-h' => commandHelp(),
        default => commandHelp("Unknown command: {$command}"),
    };
} catch (DotenvException $e) {
    stderr('✗ ' . $e->getMessage());
    $exitCode = 1;
}

exit($exitCode);

// ── Commands ─────────────────────────────────────────────────────────

/**
 * @param array<string, string|true> $options
 */
function commandDebug(array $options): int
{
    $debug = bootProject($options)->debug();

    if ($debug === []) {
        stdout('No variables loaded.');

        return 0;
    }

    $reveal = ($options['reveal'] ?? null) === true;
    stdout(sprintf('%-30s %-10s %-24s %s', 'VARIABLE', 'TYPE', 'SOURCE', 'VALUE'));
    stdout(str_repeat('─', 72));

    foreach ($debug as $name => $info) {
        if ($info['encrypted'] && !$reveal) {
            $display = '[encrypted]';
        } else {
            $display = is_scalar($info['value']) || $info['value'] === null
                ? var_export($info['value'], true)
                : get_debug_type($info['value']);
        }

        stdout(sprintf(
            '%-30s %-10s %-24s %s%s',
            $name,
            $info['type'],
            $info['source'],
            truncate($display, 40),
            $info['overridden'] ? ' (overridden)' : '',
        ));
    }

    stdout("\nTotal: " . count($debug) . ' variables.');

    return 0;
}

/**
 * @param array<string, string|true> $options
 */
function commandValidate(array $options): int
{
    $dir = projectDir($options);
    $dotenv = bootProject($options);
    $schema = option($options, 'schema');

    if ($schema !== null) {
        $schemaPath = is_file($schema) ? $schema : $dir . DIRECTORY_SEPARATOR . $schema;

        try {
            $dotenv->loadWithSchema($schemaPath);
        } catch (ValidationException $e) {
            stderr('✗ Schema validation failed:');

            foreach ($e->errors() as $error) {
                stderr("  - {$error}");
            }

            return 1;
        }

        stdout('✓ All schema rules passed.');

        return 0;
    }

    $examplePath = option($options, 'example') ?? $dir . DIRECTORY_SEPARATOR . '.env.example';

    if (!is_file($examplePath)) {
        stderr('✗ No .env.example or --schema found. Nothing to validate.');

        return 1;
    }

    $names = [];

    foreach (new EnvFileScanner()->scan(readFile($examplePath)) as $entry) {
        if ($entry->name !== null) {
            $names[] = $entry->name;
        }
    }

    // Same presence rule as the library: loaded, $_ENV, $_SERVER or getenv().
    // Works with variables_order = "GPCS" (no $_ENV), the php.ini-production default.
    try {
        $dotenv->required(...$names);
    } catch (ValidationException $e) {
        stderr('✗ Missing variables:');

        foreach ($e->errors() as $error) {
            stderr("  - {$error}");
        }

        return 1;
    }

    stdout('✓ All variables from .env.example are defined.');

    return 0;
}

/**
 * @param list<string> $positional
 * @param array<string, string|true> $options
 */
function commandEncrypt(array $positional, array $options): int
{
    $file = $positional[0] ?? '.env';
    $content = readFile($file);
    $key = option($options, 'key');

    if ($key === null) {
        $keyPair = KeyPair::generate();
        $key = $keyPair->privateKey;
        stdout('Generated new encryption key:');
        stdout("DOTENV_PRIVATE_KEY={$keyPair->privateKey}");
        stdout("Key ID: {$keyPair->publicId}");
        stdout('');
    }

    $result = new EnvFileCipher(new Encryptor($key))->encrypt($content);
    $output = option($options, 'output') ?? $file;

    if (file_put_contents($output, $result->content) === false) {
        stderr("✗ Cannot write {$output}");

        return 1;
    }

    stdout('✓ Encrypted ' . count($result->changed) . " value(s) in {$output}");
    printSkipped($result->skipped);
    stdout('Store DOTENV_PRIVATE_KEY securely — it is required for decryption.');

    return 0;
}

/**
 * @param list<string> $positional
 * @param array<string, string|true> $options
 */
function commandDecrypt(array $positional, array $options): int
{
    $file = $positional[0] ?? '.env';
    $key = option($options, 'key') ?? processKey();

    if ($key === null) {
        stderr('✗ No decryption key provided. Use --key=<hex> or set DOTENV_PRIVATE_KEY.');

        return 1;
    }

    $result = new EnvFileCipher(new Encryptor($key))->decrypt(readFile($file));
    $output = option($options, 'output') ?? $file;

    if (file_put_contents($output, $result->content) === false) {
        stderr("✗ Cannot write {$output}");

        return 1;
    }

    stdout('✓ Decrypted ' . count($result->changed) . " value(s) in {$output}");

    return 0;
}

/**
 * @param array<string, string|true> $options
 */
function commandCacheDump(array $options): int
{
    $output = option($options, 'output') ?? projectDir($options) . DIRECTORY_SEPARATOR . '.env.cache.php';
    $dotenv = bootProject($options);
    $dotenv->dumpCache($output);

    stdout(sprintf(
        '✓ Cache written to %s (%d variable(s), environment: %s)',
        $output,
        count($dotenv->variables()),
        $dotenv->environment() ?? 'dev',
    ));

    return 0;
}

/**
 * @param array<string, string|true> $options
 */
function commandCacheClear(array $options): int
{
    $path = option($options, 'path') ?? projectDir($options) . DIRECTORY_SEPARATOR . '.env.cache.php';
    new PhpFileCache()->clear($path);
    stdout("✓ Cache cleared: {$path}");

    return 0;
}

/** @param list<int|string> $names */
function reportOnlyIn(string $label, array $names): void
{
    if ($names === []) {
        return;
    }

    stdout("Only in {$label}:");

    foreach ($names as $name) {
        stdout("  + {$name}");
    }
}

/** @param array<string, array{string, string}> $different */
function reportDifferent(string $label1, string $label2, array $different): void
{
    if ($different === []) {
        return;
    }

    stdout('Different values:');

    foreach ($different as $name => [$value1, $value2]) {
        stdout("  ~ {$name}");
        stdout("    {$label1}: {$value1}");
        stdout("    {$label2}: {$value2}");
    }
}

/**
 * @param list<string> $positional
 */
function commandDiff(array $positional): int
{
    if (count($positional) < 2) {
        stderr('Usage: kariricode-dotenv diff <file1> <file2>');

        return 1;
    }

    [$file1, $file2] = $positional;
    $parser = new DotenvParser();
    $key = processKey();
    $encryptor = $key !== null ? new Encryptor($key) : null;
    $vars1 = $parser->parse(readFile($file1), $file1);
    $vars2 = $parser->parse(readFile($file2), $file2);

    $plain = static fn(string $value): string => $encryptor !== null ? $encryptor->decrypt($value) : $value;
    $shown = static fn(string $value): string => Encryptor::isEncrypted($value) ? '[encrypted]' : $value;

    $onlyIn1 = array_keys(array_diff_key($vars1, $vars2));
    $onlyIn2 = array_keys(array_diff_key($vars2, $vars1));
    $different = [];

    foreach (array_intersect_key($vars1, $vars2) as $name => $value) {
        if ($plain($value) !== $plain($vars2[$name])) {
            $different[$name] = [$shown($value), $shown($vars2[$name])];
        }
    }

    if ($onlyIn1 === [] && $onlyIn2 === [] && $different === []) {
        stdout('✓ Files are identical.');

        return 0;
    }

    reportOnlyIn(basename($file1), $onlyIn1);
    reportOnlyIn(basename($file2), $onlyIn2);
    reportDifferent(label1: basename($file1), label2: basename($file2), different: $different);

    return 0;
}

/**
 * @param list<string> $positional
 * @param array<string, string|true> $options
 */
function commandExampleGenerate(array $positional, array $options): int
{
    $input = $positional[0] ?? '.env';
    $output = option($options, 'output') ?? '.env.example';
    $lines = [];

    // Assignments keep only their name — multiline bodies (e.g. PEM keys) are dropped entirely.
    foreach (new EnvFileScanner()->scan(readFile($input)) as $entry) {
        $lines[] = $entry->name === null
            ? $entry->text
            : ($entry->exported ? 'export ' : '') . $entry->name . '=';
    }

    if (file_put_contents($output, implode("\n", $lines)) === false) {
        stderr("✗ Cannot write {$output}");

        return 1;
    }

    stdout("✓ Generated {$output} from {$input}");

    return 0;
}

function commandKeygen(): int
{
    $keyPair = KeyPair::generate();
    stdout("Key ID:              {$keyPair->publicId}");
    stdout("DOTENV_PRIVATE_KEY=  {$keyPair->privateKey}");
    stdout('');
    stdout('Add to your server environment (NOT to .env files):');
    stdout("  export DOTENV_PRIVATE_KEY={$keyPair->privateKey}");

    return 0;
}

function commandHelp(string $error = ''): int
{
    if ($error !== '') {
        stderr($error);
        stderr('');
    }

    stdout('KaririCode Dotenv CLI');
    stdout('');
    stdout('Usage: kariricode-dotenv <command> [arguments] [options]');
    stdout('');
    stdout('Commands:');
    stdout('  debug               List loaded variables (encrypted values masked; --reveal shows them)');
    stdout('  validate            Validate against --schema=<file> or .env.example');
    stdout('  encrypt [file]      Encrypt values (--key=<hex>, or a new key is generated)');
    stdout('  decrypt [file]      Decrypt values (--key=<hex> or DOTENV_PRIVATE_KEY)');
    stdout('  cache:dump          Write .env.cache.php from the bootEnv() cascade');
    stdout('  cache:clear         Remove the cache file (--path=<file>)');
    stdout('  diff <f1> <f2>      Compare the parsed values of two .env files');
    stdout('  example:generate    Write .env.example with names only');
    stdout('  keygen              Generate a new encryption key');
    stdout('');
    stdout('Options:');
    stdout('  --dir=<path>        Project directory (default: current directory)');
    stdout('  --env=<name>        Environment for the bootEnv() cascade (default: APP_ENV or dev)');
    stdout('  --mode=<mode>       immutable (default) | overwrite | skip-existing');
    stdout('  --output=<file>     Output file');

    return $error !== '' ? 1 : 0;
}

// ── Helpers ──────────────────────────────────────────────────────────

/**
 * @param list<string> $arguments
 *
 * @return array{0: list<string>, 1: array<string, string|true>}
 */
function parseArguments(array $arguments): array
{
    $positional = [];
    $options = [];

    foreach ($arguments as $argument) {
        if (!str_starts_with($argument, '--')) {
            $positional[] = $argument;

            continue;
        }

        $equals = strpos($argument, '=');

        if ($equals === false) {
            $options[substr($argument, 2)] = true;
        } else {
            $options[substr(string: $argument, offset: 2, length: $equals - 2)] = substr($argument, $equals + 1);
        }
    }

    return [$positional, $options];
}

/**
 * @param array<string, string|true> $options
 */
function option(array $options, string $name): ?string
{
    $value = $options[$name] ?? null;

    return is_string($value) && $value !== '' ? $value : null;
}

/**
 * @param array<string, string|true> $options
 */
function projectDir(array $options): string
{
    return option($options, 'dir') ?? (string) getcwd();
}

/**
 * Loads the project exactly like an application calling bootEnv().
 *
 * @param array<string, string|true> $options
 */
function bootProject(array $options): Dotenv
{
    $mode = option($options, 'mode') ?? 'immutable';
    $loadMode = match ($mode) {
        'immutable' => LoadMode::Immutable,
        'overwrite' => LoadMode::Overwrite,
        'skip-existing' => LoadMode::SkipExisting,
        default => throw ConfigurationException::invalidOption(option: 'mode', value: $mode, allowed: 'immutable, overwrite, skip-existing'),
    };

    $dotenv = new Dotenv(projectDir($options), new DotenvConfiguration(loadMode: $loadMode));
    $dotenv->bootEnv(option($options, 'env'));

    return $dotenv;
}

function processKey(): ?string
{
    $key = $_SERVER['DOTENV_PRIVATE_KEY'] ?? $_ENV['DOTENV_PRIVATE_KEY'] ?? getenv('DOTENV_PRIVATE_KEY');

    return is_string($key) && $key !== '' ? $key : null;
}

function readFile(string $path): string
{
    $content = is_file($path) && is_readable($path) ? file_get_contents($path) : false;

    if ($content === false) {
        throw FileNotFoundException::forPath($path);
    }

    return $content;
}

/**
 * @param array<string, string> $skipped
 */
function printSkipped(array $skipped): void
{
    foreach ($skipped as $name => $reason) {
        stdout("  skipped {$name}: {$reason}");
    }
}

function stdout(string $message): void
{
    fwrite(STDOUT, $message . "\n");
}

function stderr(string $message): void
{
    fwrite(STDERR, $message . "\n");
}

function truncate(string $text, int $max): string
{
    return strlen($text) > $max ? substr(string: $text, offset: 0, length: $max - 3) . '...' : $text;
}
