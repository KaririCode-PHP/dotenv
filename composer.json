{
    "name": "kariricode/dotenv",
    "description": "Production-grade PHP dotenv with type casting, AES-256-GCM encrypted values, an OPcache-friendly cache, a validation DSL, environment-aware loading and a CLI, for PHP 8.4+, ARFA 1.3.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "framework",
        "php",
        "configuration",
        "dotenv",
        "environment-variables",
        "env",
        "kariricode",
        "type-safe",
        "immutable",
        "encrypted",
        "validation",
        "cache",
        "php84"
    ],
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "walmir.silva@kariricode.org"
        }
    ],
    "homepage": "https://kariricode.org",
    "bin": [
        "bin/kariricode-dotenv"
    ],
    "require": {
        "php": "^8.4",
        "kariricode/contract": "^2.11",
        "kariricode/exception": "^2.0.2"
    },
    "suggest": {
        "ext-openssl": "Required for encrypted .env values (AES-256-GCM)"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\Dotenv\\": "src/"
        },
        "files": [
            "src/env.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\Dotenv\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "kcode test",
        "test-unit": "kcode test --testsuite=unit,integration",
        "test-conformance": "kcode test --testsuite=conformance",
        "phpstan": "kcode run phpstan analyse --no-progress --memory-limit=1G",
        "psalm": "kcode run psalm --no-cache --show-info=false",
        "complexity": "@php tools/complexity.php",
        "mutation": [
            "Composer\\Config::disableProcessTimeout",
            "kcode run infection --threads=max --only-covering-test-cases --no-progress --show-mutations=0"
        ],
        "security": [
            "@composer validate --strict",
            "@composer audit --locked",
            "@composer audit --locked --working-dir=.kcode",
            "@php tools/secret-scan.php",
            "@php tools/secret-scan.php --self-test"
        ],
        "sbom": "@php tools/sbom.php sbom.cdx.json",
        "cs-check": "kcode cs:fix --check",
        "cs-fix": "kcode cs:fix",
        "check": [
            "@cs-check",
            "@phpstan",
            "@psalm",
            "@complexity",
            "@test",
            "@mutation"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "kariricode": {
            "arfa": {
                "version": "1.3",
                "level": 1
            },
            "asvs": {
                "version": "5.0",
                "level": 2
            },
            "spec": "4.3.3",
            "error-code-range": "ENV 2700–2799"
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    }
}
